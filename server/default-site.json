  "faq": [
    {
      "question": {
        "hr": "Kako rezervirati apartman?",
        "en": "How do I book an apartment?",
        "de": "Wie buche ich ein Apartment?"
      },
      "answer": {
        "hr": "Odaberite apartman i datume pa pošaljite upit. Domaćin potvrđuje dostupnost, konačnu cijenu i uvjete. Upit i prikaz kalendara nisu potvrda rezervacije.",
        "en": "Choose an apartment and dates, then send an enquiry. The host confirms availability, the final price and conditions. An enquiry or calendar display is not a confirmed reservation.",
        "de": "Wählen Sie Apartment und Reisedaten und senden Sie eine Anfrage. Der Gastgeber bestätigt Verfügbarkeit, Endpreis und Bedingungen. Anfrage und Kalender sind keine Buchungsbestätigung."
      }
    },
    {
      "question": {
        "hr": "Kada su prijava i odjava?",
        "en": "When are check-in and check-out?",
        "de": "Wann sind An- und Abreise?"
      },
      "answer": {
        "hr": "Točna vremena bit će dodana nakon potvrde domaćina. Za raniji dolazak ili kasniji odlazak navedite želju u upitu.",
        "en": "Exact times will be added after host confirmation. Mention requests for early arrival or late departure in your enquiry.",
        "de": "Die genauen Zeiten folgen nach Bestätigung des Gastgebers. Frühe Anreise oder späte Abreise bitte in der Anfrage angeben."
      }
    },
    {
      "question": {
        "hr": "Je li osiguran parking?",
        "en": "Is parking available?",
        "de": "Gibt es Parkplätze?"
      },
      "answer": {
        "hr": "Parking za goste nalazi se ispred kuće. Navedite broj vozila u upitu kako bi domaćin potvrdio raspoloživa mjesta.",
        "en": "Guest parking is in front of the house. Include your vehicle count so the host can confirm available spaces.",
        "de": "Gästeparkplätze befinden sich vor dem Haus. Geben Sie die Fahrzeugzahl an, damit die Gastgeberin die verfügbaren Plätze bestätigen kann."
      }
    },
    {
      "question": {
        "hr": "Jesu li kućni ljubimci dopušteni?",
        "en": "Are pets allowed?",
        "de": "Sind Haustiere erlaubt?"
      },
      "answer": {
        "hr": "Pravila još nisu potvrđena. U upitu navedite vrstu i broj kućnih ljubimaca i pričekajte potvrdu domaćina.",
        "en": "The policy is not yet confirmed. Include the type and number of pets in your enquiry and wait for host confirmation.",
        "de": "Die Regeln sind noch nicht bestätigt. Geben Sie Art und Anzahl der Haustiere an und warten Sie auf die Bestätigung."
      }
    },
    {
      "question": {
        "hr": "Mogu li doći s djecom?",
        "en": "Can I stay with children?",
        "de": "Kann ich mit Kindern anreisen?"
      },
      "answer": {
        "hr": "U obrascu navedite broj odraslih i djece. Dostupnost dječjeg krevetića, hranilice i ostale opreme potrebno je potvrditi s domaćinom.",
        "en": "Enter the number of adults and children in the form. Cots, high chairs and other equipment must be confirmed with the host.",
        "de": "Geben Sie die Anzahl der Erwachsenen und Kinder an. Babybett, Hochstuhl und andere Ausstattung müssen bestätigt werden."
      }
    },
    {
      "question": {
        "hr": "Kako se plaća i koji su uvjeti otkazivanja?",
        "en": "What are the payment and cancellation terms?",
        "de": "Welche Zahlungs- und Stornobedingungen gelten?"
      },
      "answer": {
        "hr": "Iznos predujma, način plaćanja i uvjete otkazivanja domaćin će navesti u ponudi prije potvrde rezervacije.",
        "en": "The host will state the deposit, payment method and cancellation terms in the offer before you confirm the booking.",
        "de": "Anzahlung, Zahlungsweise und Stornobedingungen nennt der Gastgeber im Angebot vor der Buchungsbestätigung."
      }
    }
  ],
