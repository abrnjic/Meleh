{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://meleh-ce687.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    },
    {
      "source": "/apartmani/:slug",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/calendar-background",
      "schedule": "*/15 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/apartmani/maslina",
      "destination": "/apartmani",
      "permanent": true
    },
    {
      "source": "/apartmani/lavanda",
      "destination": "/apartmani",
      "permanent": true
    },
    {
      "source": "/apartmani/more",
      "destination": "/apartmani",
      "permanent": true
    },
    {
      "source": "/fotografije",
      "destination": "/galerija",
      "permanent": true
    }
  ]
}
