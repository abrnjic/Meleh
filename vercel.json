{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://meleh-ce687.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    },
    {
      "source": "/",
      "destination": "/api/index?route=seo-page&pagePath=/"
    },
    {
      "source": "/apartmani",
      "destination": "/api/index?route=seo-page&pagePath=/apartmani"
    },
    {
      "source": "/o-nama",
      "destination": "/api/index?route=seo-page&pagePath=/o-nama"
    },
    {
      "source": "/galerija",
      "destination": "/api/index?route=seo-page&pagePath=/galerija"
    },
    {
      "source": "/kontakt",
      "destination": "/api/index?route=seo-page&pagePath=/kontakt"
    },
    {
      "source": "/kako-do-nas",
      "destination": "/api/index?route=seo-page&pagePath=/kako-do-nas"
    },
    {
      "source": "/vodic",
      "destination": "/api/index?route=seo-page&pagePath=/vodic"
    },
    {
      "source": "/faq",
      "destination": "/api/index?route=seo-page&pagePath=/faq"
    },
    {
      "source": "/dostupnost",
      "destination": "/api/index?route=seo-page&pagePath=/dostupnost"
    },
    {
      "source": "/usporedba",
      "destination": "/api/index?route=seo-page&pagePath=/usporedba"
    },
    {
      "source": "/pronadi-apartman",
      "destination": "/api/index?route=seo-page&pagePath=/pronadi-apartman"
    },
    {
      "source": "/privatnost",
      "destination": "/api/index?route=seo-page&pagePath=/privatnost"
    },
    {
      "source": "/uvjeti",
      "destination": "/api/index?route=seo-page&pagePath=/uvjeti"
    },
    {
      "source": "/admin",
      "destination": "/api/index?route=seo-page&pagePath=/admin"
    },
    {
      "source": "/gost",
      "destination": "/api/index?route=seo-page&pagePath=/gost"
    },
    {
      "source": "/apartmani/:slug",
      "destination": "/api/index?route=seo-page&pagePath=/apartmani/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?route=sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?route=robots.txt"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "server/page-template.html"
    }
  },
  "crons": [
    {
      "path": "/api/calendar-background",
      "schedule": "*/15 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/apartmani/maslina",
      "destination": "/apartmani",
      "permanent": true
    },
    {
      "source": "/apartmani/lavanda",
      "destination": "/apartmani",
      "permanent": true
    },
    {
      "source": "/apartmani/more",
      "destination": "/apartmani",
      "permanent": true
    },
    {
      "source": "/fotografije",
      "destination": "/galerija",
      "permanent": true
    },
    {
      "source": "/plan-dana",
      "destination": "/vodic",
      "permanent": true
    }
  ]
}
