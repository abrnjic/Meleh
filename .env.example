# Server-only Firebase administrator identity. Never commit the real value.
ADMIN_EMAIL=
# Optional additional administrator emails, separated by commas (server only).
ADMIN_EMAILS=
# Firebase Admin service-account credentials (server only).
# Project and bucket default to the public server/firebase-web.json config.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Optional public web-key override; the supplied project key is already configured.
FIREBASE_API_KEY=
# Email provider: configure later with a verified sender domain.
RESEND_API_KEY=
MAIL_FROM=
INQUIRY_TO=
# A random secret of at least 32 characters; hashes rate-limit identifiers.
INQUIRY_RATE_LIMIT_SALT=

# Optional keyless production access via Vercel OIDC and Google Workload Identity.
# Enabled only when VERCEL_ENV=production; never put an OIDC token here.
FIREBASE_FEDERATION_ENABLED=
FIREBASE_WORKLOAD_IDENTITY_PROVIDER=
FIREBASE_FEDERATED_SERVICE_ACCOUNT=
