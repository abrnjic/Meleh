# Meleh Apartmani — predložak konfiguracije.
# Kopirati u .env.local za lokalni razvoj; upute su u SETUP.md.
# Sve vrijednosti namjerno su prazne. Ne unositi stvarne podatke u ovaj predložak.
# Produkcijske tajne postavljaju se u Vercel Production okruženju.

# Lokalni razvoj: opcionalni port (zadano 4174).
PORT=

# Administratorski Google računi — isključivo serverska konfiguracija.
# Primarni račun i dodatni računi odvojeni zarezima.
ADMIN_EMAIL=
ADMIN_EMAILS=

# Javne Firebase postavke — nisu serverske vjerodajnice.
# Zadane vrijednosti nalaze se u server/firebase-web.json.
# Pri promjeni projekta uskladiti sve tri vrijednosti, authDomain i auth proxy.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=

# Produkcijski pristup bez privatnog ključa: Vercel OIDC / Google federacija.
# FIREBASE_FEDERATION_ENABLED postaviti na true samo za konfiguriranu federaciju.
# Aktivira se isključivo uz Vercelov VERCEL_ENV=production.
# Provider: projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
# Servisni račun mora pripadati odabranom Firebase projektu.
FIREBASE_FEDERATION_ENABLED=
FIREBASE_WORKLOAD_IDENTITY_PROVIDER=
FIREBASE_FEDERATED_SERVICE_ACCOUNT=

# Alternativni serverski pristup servisnim ključem.
# Za lokalni razvoj koristiti zaseban razvojni Firebase projekt.
# Nije potrebno kada je produkcijska federacija aktivna.
# Privatni ključ podržava nove retke ili doslovne znakove \n.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend — serverske postavke; potreban je verificirani pošiljatelj.
# INQUIRY_TO je privatni primatelj upita, a ne javni kontakt stranice.
RESEND_API_KEY=
MAIL_FROM=
INQUIRY_TO=
# Nasumična tajna od najmanje 32 znaka za HMAC identifikatore ograničenja upita.
INQUIRY_RATE_LIMIT_SALT=

# Vercel Cron — zasebna nasumična tajna od najmanje 32 znaka.
# Štiti /api/calendar-background; raspored je definiran u vercel.json.
CRON_SECRET=

# VERCEL, VERCEL_ENV i OIDC tokene pribavlja Vercel/runtime.
# Ne postavljati ih ručno u ovaj predložak ili radi simulacije produkcijske federacije.
# SEO domenu i verifikacijske kodove uređivati u administraciji, ne kroz .env.
